# Usar DATABASE_URL o las variables individuales de abajo, no es necesario definir ambas opciones.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=dbingeso
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SYNCHRONIZE=true
PORT=3001
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret

# Opcionales para recuperación de contraseña por correo
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# Solo para ejecutar npm run create-admin
ADMIN_API_URL=http://localhost:3001/api/v1
ADMIN_NAME=Administrador UCN
ADMIN_EMAIL=
ADMIN_PASSWORD=